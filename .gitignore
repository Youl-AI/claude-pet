# 빌드 산출물. 'bin/' 로 두면 깊이를 가리지 않아 배포 대상인 plugin/bin 까지
# 삼킨다 — 그 결과 클론한 사용자에게 pet.exe 가 전달되지 않고, 훅은 Test-Path
# 에서 조용히 넘어가 "아무 일도 안 일어나는 플러그인"이 된다. 그래서 소스
# 트리에 한정한다.
src/**/bin/
tests/**/bin/
obj/

# plugin/bin/pet.exe 는 배포물이므로 추적한다. 디버그 심볼만 제외한다 —
# 사용자에게 쓸모가 없고, 작성자의 절대 경로(사용자명 포함)를 담고 있다.
plugin/bin/*.pdb

*.user
.superpowers/
